# ── CineVerse Backend — Environment Variables ───────────────
# Copy this file to .env and fill in real values.
# The .env file is gitignored. NEVER commit .env.

# Neo4j AuraDB (Phase 0 — filled in after provisioning)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# TMDB API (Phase 1)
TMDB_API_KEY=your-tmdb-api-key

# Jikan is public — no key needed (rate-limited at 3 req/s)
