# CineVerse Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file!

# ── Backend (optional) ────────────────────────────────────────
# If backend is deployed, set this. If left empty, the frontend
# calls TMDB + Jikan directly from the browser.
VITE_API_BASE_URL=

# ── TMDB API Key (for movie search + trending) ────────────────
# Get a FREE key at: https://www.themoviedb.org/settings/api
# Without this, only anime search (Jikan) works.
VITE_TMDB_API_KEY=

# ── ML Service (optional) ─────────────────────────────────────
VITE_ML_API_BASE_URL=
